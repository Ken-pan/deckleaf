{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowJs": true, "skipLibCheck": true, "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["svelte", "node", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "server/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
